# Copy to .env (git-ignored) and fill in. bin/run-with-env.sh sources this file
# before starting the server, so the password never has to live in Codex's config.toml.
SN_URL=https://<instance>.service-now.com
SN_USER=mcp_local
SN_PASSWORD=change-me

# Optional
# SN_TIMEOUT_MS=15000          # per REST call; keep well under Codex tool_timeout_sec
# SN_READ_ONLY=true            # register only read tools (writes, admin, ops, catalog ordering disabled)
# SN_TOOLSETS=core,admin,context,ops,catalog   # which tool groups to expose
# SN_MAX_RESPONSE_CHARS=24000  # hard cap per tool result
